{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "functions": {
    "server.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/send-lead", "destination": "/api/send" },
    { "source": "/send-lead-course", "destination": "/api/send" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
