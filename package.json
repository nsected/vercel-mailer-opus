{
  "name": "vercel-mailer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express contact form with Gmail SMTP for Vercel, Render, or a VPS",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "build": "echo 'No build step required'",
    "deploy": "vercel --prod",
    "dev": "node --env-file=.env --watch server.js",
    "develop": "npm run dev",
    "start": "node server.js",
    "start:local": "node --env-file=.env server.js"
  },
  "dependencies": {
    "nodemailer": "^6.9.0",
    "express": "^5.3.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "vercel": "^65.15.0"
  }
}
